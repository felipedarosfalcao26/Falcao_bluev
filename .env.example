# URL pública do site, usada para metadata/SEO e sitemap (defina em produção)
NEXT_PUBLIC_SITE_URL=https://www.bluev.com.br

# Mapa de carregadores (Mapbox) - crie uma conta gratuita em https://account.mapbox.com/
# e gere um "Default public token". Sem essa chave, o mapa cai automaticamente
# para uma visualizacao em lista.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Numero de WhatsApp da BlueV, apenas digitos, com codigo do pais (ex: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Meta Pixel (Facebook/Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=

# Banco de dados (Postgres/Supabase) - usado futuramente pela camada services/
DATABASE_URL=

# CMS headless (opcional, futuro blog dinamico) - ex: Sanity, Strapi
CMS_API_URL=
CMS_API_TOKEN=

# Endpoint de CRM/email para onde os formularios de lead serao enviados
LEADS_WEBHOOK_URL=
